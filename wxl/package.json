{
  "name": "wxl-food",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:api": "tsc -p services/coordination-api/tsconfig.json",
    "start:api": "node services/coordination-api/dist/server.js",
    "start:event-worker": "node services/coordination-api/dist/event-worker.js",
    "start:payment-worker": "node services/coordination-api/dist/payment-worker.js",
    "start:retention-worker": "node services/coordination-api/dist/retention-worker.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "node --test services/coordination-api/dist/*.test.js",
    "test:worker": "python3 -m unittest discover -s services/matching-worker/tests -v",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
