/mosquitos/

# NotebookLM CLI state (local artifacts, references personal notebook IDs)
funding/updates/.history.jsonl
funding/updates/.notebooks.json

# Audio renders (too large for git history; keep in cloud storage / NotebookLM)
funding/updates/*.m4a
__pycache__/

# Lead source photos (originals); only the optimized webp under web/demos/ are committed
biz/*/photos/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Client rebuild source material (site mirrors, raw scrape JSON, reference
# screenshots). Large, and may contain markup from compromised origin sites.
# Only the built client site under clients/<name>/ is committed.
clients/.source/

# Three Hands Healing: raw client photo drops (240 MB) stay local; web-sized copies live in web/threehandshealing/assets/photos
threehandshealing/*.zip

# Kohsi (ex Akosi, ex koordi, ex koord) lives in its own PRIVATE repo HandProtocol/kohsi (records 0014, 0022, 0084, 0089).
# The folder is kohsi/; koordi and koord are symlinks to it, akosi is a symlink to the archived drop folder.
kohsi/
koordi/
koordi
koord
akosi/
akosi

# Other repos checked out inside this folder: never part of handprotocol
koordi-wl/
koordi-wt/
viz3d/

# PrecisionFix is self-hosted on the owner's own accounts since 2026-11-02 (his Supabase, his Netlify).
# Its code lives in HandProtocol/precisionfix-mobile; the local copy and HAND-DB migrations stay out of this repo.
clients/precisionfix/
command/supabase/migrations/*precisionfix*

