# SaleScale environment template.
# Copy to .env.local and fill values. Never commit .env.local.

# Supabase project (a fork may share a project with other tenants,
# isolated by the schema name set in salescale.config.ts).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Required only for server actions that need elevated
# access (migrations, bulk operations, notification fan-out).
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used to build absolute links in emails and webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3001
