# HAND Command Center environment variables.
# Copy to .env.local and fill in. Never commit real values.

# Supabase project (will be wired in v1.1, scaffold compiles without them)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the auth callback for absolute redirect URLs.
# Default is http://127.0.0.1:3000 in local dev.
NEXT_PUBLIC_SITE_URL=

# AI provider keys for the drafting assistant and RFP extractor.
# Set ANY ONE to take the routes out of stub mode. If multiple are set,
# AI_PRIMARY_PROVIDER decides the lead; the others act as fallbacks.
# Default primary is xai. Operator-facing UI never names the provider.
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# AI_PRIMARY_PROVIDER=xai
# AI_FALLBACK_PROVIDERS=anthropic
# AI_DEFAULT_MODEL=grok-3-mini
# XAI_DEFAULT_MODEL=grok-3-mini
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Quick-capture inbox shared secret for the /api/inbox/capture endpoint.
# Generate any string; clients pass it in the `x-hand-capture-key` header.
INBOX_CAPTURE_KEY=

# UX inspector deep-link base. Defaults to https://command.handprotocol.org
# when unset. Override for staging or local hosts.
NEXT_PUBLIC_COMMAND_BASE_URL=

# Telegram notifier (UX inspector pins).
# When all three are set, createPin posts a message to the inspector forum
# topic in the HAND group. Missing any one -> notification silently no-ops.
# Provision the topic with nerve/agents/hand/src/scripts/setup-inspector-topic.ts
TELEGRAM_BOT_TOKEN=
FORUM_GROUP_ID=
INSPECTOR_TOPIC_ID=

# Transactional email (Resend) for invite + apply emails.
# Both must be set for email to send; missing either no-ops silently (the
# invite link still works — email is dormant until the sending domain verifies).
# EMAIL_FROM is a verified sender, e.g. "HAND Protocol <team@handprotocol.org>".
RESEND_API_KEY=
EMAIL_FROM=
